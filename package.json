{
  "name": "oyi-interaction",
  "version": "0.1.0",
  "description": "Shared Oyi human-interaction foundation (state, truth, composer, caption, suggestions, confirmation, action result, history, shell, orb fallback, surface adapter contract) for Oyi Consumer and Facility.",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./styles.css": "./dist/styles/oyi-interaction.css",
    "./fixtures/oyi-action-truth.fixture.json": "./fixtures/oyi-action-truth.fixture.json",
    "./package.json": "./package.json",
    "./fixtures/expectations-lib.mjs": "./scripts/expectations-lib.mjs",
    "./fixtures/oyi-interaction-expectations.json": "./fixtures/oyi-interaction-expectations.json"
  },
  "files": [
    "dist",
    "fixtures",
    "scripts/expectations-lib.mjs",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "guard": "node scripts/guard.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "check": "npm run typecheck && npm run guard && npm run build && npm run verify:dist && npm run expectations && npm test",
    "expectations": "node scripts/expectations.mjs"
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED"
}
